# Copy this file to .product_price_monitor.env or ~/.config/product-price-monitor.env.
# Do not commit or share the real file.

# Gmail SMTP requires an app password. A normal account password will fail.
PRICE_SMTP_HOST=smtp.gmail.com
PRICE_SMTP_USERNAME=your@gmail.com
PRICE_SMTP_PASSWORD=your_gmail_app_password
PRICE_SMTP_FROM=your@gmail.com
PRICE_SMTP_TO=recipient@example.com

# QQ Mail example:
# PRICE_SMTP_HOST=smtp.qq.com
# PRICE_SMTP_USERNAME=your@qq.com
# PRICE_SMTP_PASSWORD=your_qq_mail_authorization_code
# PRICE_SMTP_FROM=your@qq.com
# PRICE_SMTP_TO=recipient@example.com

# Optional backup channels
# PRICE_TELEGRAM_BOT_TOKEN=
# PRICE_TELEGRAM_CHAT_ID=
# PRICE_BARK_DEVICE_KEY=
# PRICE_NTFY_TOPIC=
# PRICE_PUSHPLUS_TOKEN=

# Optional Goofish / 闲鱼 public reference cookie. Leave empty unless the public
# request is rate-limited or blocked by an anti-bot check.
# PRICE_GOOFISH_COOKIE=
# PRICE_GOOFISH_USER_AGENT=
